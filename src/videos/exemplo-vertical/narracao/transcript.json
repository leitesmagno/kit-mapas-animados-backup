 "duracao": 107.668,
 "segmentos": [
  {
   "id": 0,
   "inicio": 0.05,
   "fim": 4.27,
   "texto": "O maior rio do mundo atravessa o Amazonas inteiro e não existe uma única ponte sobre ele."
  },
  {
   "id": 1,
   "inicio": 4.599,
   "fim": 11.239,
   "texto": "e o maior estado do Brasil ainda guarda um teatro de ópera no meio da selva, praias de rio e cachoeiras escondidas na mata."
  },
  {
   "id": 2,
   "inicio": 11.843,
   "fim": 18.403,
   "texto": "Fica no norte, faz divisa com Roraima, Pará, Mato Grosso, Rondônia e Acre e fronteira com a Venezuela, a Colômbia e o Peru."
  },
  {
   "id": 3,
   "inicio": 18.794,
   "fim": 24.854,
   "texto": "São 62 municípios e mais de 4 milhões de pessoas, metade vive em Manaus, a maior cidade do Norte."
  },
  {
   "id": 4,
   "inicio": 25.198,
   "fim": 29.118,
   "texto": "E chegar lá é uma aventura, quase todo mundo vai de avião ou de barco."
  },
  {
   "id": 5,
   "inicio": 29.318,
   "fim": 34.138,
   "texto": "Por terra, a BR319 tem centenas de quilômetros de terra no meio da floresta."
  },
  {
   "id": 6,
   "inicio": 34.474,
   "fim": 40.354,
   "texto": "No auge da borracha, Manaus era chamada de Paris dos Trópicos e ergueu o teatro Amazonas com peças trazidas da Europa."
  },
  {
   "id": 7,
   "inicio": 40.904,
   "fim": 46.544,
   "texto": "até que um inglês levou 70 mil sementes de seringueira que viraram plantações na Ásia e a riqueza acabou."
  },
  {
   "id": 8,
   "inicio": 47.02,
   "fim": 51.66,
   "texto": "Décadas depois veio a zona franca, hoje quase toda a moto fabricada no Brasil sai de Manaus."
  },
  {
   "id": 9,
   "inicio": 51.96,
   "fim": 55.56,
   "texto": "Na cidade ainda tem o Mercado Adolpho Lisboa e a Praia da Ponta Negra."
  },
  {
   "id": 10,
   "inicio": 55.856,
   "fim": 61.296,
   "texto": "Em frente, o negro escuro encontra o Solimões, barrento e eles correm quilômetros sem se misturar."
  },
  {
   "id": 11,
   "inicio": 61.576,
   "fim": 63.196,
   "texto": "Juntos viram o Rio Amazonas."
  },
  {
   "id": 12,
   "inicio": 63.727,
   "fim": 66.147,
   "texto": "Mas é saindo de Manaus que o Amazonas impressiona."
  },
  {
   "id": 13,
   "inicio": 66.447,
   "fim": 69.047,
   "texto": "No Lago Janauari, as vitórias-régias passam de dois metros."
  },
  {
   "id": 14,
   "inicio": 69.559,
   "fim": 74.259,
   "texto": "Em Novo Airão, as anavilhanas formam um labirinto de 400 ilhas com botos-cor-de-rosa."
  },
  {
   "id": 15,
   "inicio": 74.577,
   "fim": 77.917,
   "texto": "Presidente Figueiredo tem mais de 100 cachoeiras e grutas no meio da mata."
  },
  {
   "id": 16,
   "inicio": 78.316,
   "fim": 83.556,
   "texto": "Em Parintins, uma ilha no meio do rio, o Festival dos Bois divide a cidade entre garantido e caprichoso."
  },
  {
   "id": 17,
   "inicio": 83.883,
   "fim": 89.223,
   "texto": "Em Maués nasceu o guaraná para os Sateré-Mawé, ele brotou dos olhos de um menino e, por isso, parece um olho."
  },
  {
   "id": 18,
   "inicio": 89.555,
   "fim": 96.755,
   "texto": "O Amazonas tem mais indígenas que qualquer estado, mais de 490 mil, e no Vale do Javari vivem povos isolados até hoje."
  },
  {
   "id": 19,
   "inicio": 97.108,
   "fim": 101.108,
   "texto": "No extremo norte, o pico da Neblina é o teto do Brasil, com quase 3 mil metros."
  },
  {
   "id": 20,
   "inicio": 101.5,
   "fim": 105.3,
   "texto": "Do Encontro das Águas ao Pico da Neblina, o Amazonas é cheio de lugares para descobrir?"
  },
  {
   "id": 21,
   "inicio": 105.866,
   "fim": 107.446,
   "texto": "Qual desses lugares você já conhecia?"
  }
 ],
