# Copie para .env (o `npm run instalar` já copia) e preencha SÓ o que for usar.
# O .env nunca vai para o Git nem para a pasta public/.

# Voz por IA (opcional — quem grava a própria voz não precisa): https://elevenlabs.io
# Profile → API Keys; a chave precisa só da permissão "Text to Speech".
ELEVENLABS_API_KEY=

# Imagens de apoio e camadas de thumbnail (opcional): https://aistudio.google.com/apikey
GEMINI_API_KEY=
